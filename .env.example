# Create a Clerk application, enable Google and GitHub, and add this key.
VITE_CLERK_PUBLISHABLE_KEY=

# Keep this server-only. Never prefix it with VITE_.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Comma-separated Clerk authorized parties. Add the exact deployed app origin in production.
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,http://localhost:3000

# Local SQLite database. The parent directory is created automatically.
DATABASE_PATH=./data/mocktest.sqlite
PORT=3000
