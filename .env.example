# Optional override. The Clerk CLI publishable key works too.
VITE_CLERK_PUBLISHABLE_KEY=

# Keep this server-only. Never prefix it with VITE_.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Local authorized parties. On Vercel, leave this unset to use Vercel's project and deployment URLs.
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL Docker service in compose.yaml. Vercel should use Supabase's transaction pooler URL.
DATABASE_URL=postgresql://mocktest:mocktest@127.0.0.1:5432/mocktest
PORT=3001
